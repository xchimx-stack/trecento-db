{
  "name": "art-network",
  "version": "1.1.0-rc9",
  "private": true,
  "scripts": {
    "dev": "serve public",
    "import:ulan": "node scripts/import-ulan.mjs",
    "build": "node -e \"console.log('Art Network: generic production viewer/admin; database maintenance is not run during deployment')\"",
    "db:seed": "node scripts/seed-supabase.mjs",
    "site:build": "node scripts/build-static.mjs",
    "db:repair-family": "node scripts/repair-ulan-family.mjs",
    "db:repair-names": "node scripts/repair-artist-names.mjs",
    "expand:ulan": "node scripts/expand-ulan-one-hop.mjs",
    "db:reject-wiki-chronology": "node scripts/reject-implausible-wikipedia-edges.mjs",
    "db:repair-identities": "node scripts/repair-identity-collisions.mjs",
    "db:reject-long-wiki": "node scripts/reject-long-gap-wikipedia-evidence.mjs",
    "maintenance": "node scripts/repair-identity-collisions.mjs && node scripts/reject-implausible-wikipedia-edges.mjs && node scripts/reject-long-gap-wikipedia-evidence.mjs && node scripts/expand-ulan-one-hop.mjs && node scripts/build-static.mjs",
    "test:current": "node scripts/test-current-regression.mjs",
    "test:discovery": "node scripts/test-discovery-contract.mjs",
    "test:discovery-regression": "node scripts/test-discovery-regression.mjs",
    "test:function-count": "node scripts/test-function-count.mjs",
    "test:api-consolidation": "node scripts/test-api-consolidation.mjs",
    "test:ulan-direction": "node scripts/test-ulan-directionality.cjs",
    "test:v1": "node scripts/test-v1-normalizer.cjs",
    "test:v1-auth": "node scripts/test-v1-admin-auth.cjs",
    "test:production": "node scripts/test-production-generic.mjs"
  },
  "devDependencies": {
    "serve": "14.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4"
  }
}
